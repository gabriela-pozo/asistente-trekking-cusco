# Copia este archivo como .env y pon tus valores reales. Nunca subas el .env al repo.

# Proveedor del modelo: gemini (por defecto) o claude
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Respaldo: se usa si el principal se queda sin cuota diaria o sigue saturado
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite

# Claude (alternativa)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# WhatsApp con el sandbox de Twilio (server/webhook.py)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL exacta configurada en Twilio ("When a message comes in"); se usa para validar la firma
URL_PUBLICA=
# 1 = el webhook responde también dentro del horario (para probar de día)
FORZAR_MODO_NOCTURNO=0
