# Copia este archivo como .env y pon tus valores reales. Nunca subas el .env al repo.

# Proveedor del modelo: gemini (por defecto) o claude
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Respaldo: se usa si el principal se queda sin cuota diaria o sigue saturado
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite

# Claude (alternativa)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
